meta {
  name: Cambiar Contraseña (Usuario Autenticado)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/auth/cambiar-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "passwordActual": "PasswordSegura123",
    "nuevaPassword": "MiNuevaPasswordSuperSegura2026"
  }
}
