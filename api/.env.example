# Configuración del Servidor
SERVER_PORT=8081

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodega_diza
DB_USER=postgres
DB_PASSWORD=

# Configuración de JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Configuración de JWT (OBLIGATORIO)
# Secreto Base64 de al menos 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# Origen permitido (CORS)
CORS_ALLOWED_ORIGIN=https://diza.abdieeel.dev

# Deshabilitado en producción
DIZA_DEMO_ENABLED=false

# Usuario administrador inicial (configurar solo en el primer arranque y luego vaciar)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador Bodega DIZA

# Configuración de Correo Electrónico (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
