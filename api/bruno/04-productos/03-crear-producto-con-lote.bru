meta {
  name: Registrar Producto (con Lote Inicial)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/productos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
