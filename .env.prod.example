# Copia este archivo a .env.prod y completa los valores reales antes de levantar:
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Base de datos Supabase (recomendado: Session Pooler IPv4 en puerto 5432 o Transaction Pooler en 6543)
# En Supabase Dashboard -> Connect -> Session pooler:
#   Host: aws-0-<region>.pooler.supabase.com
#   Port: 5432
#   Database: postgres
#   User: postgres.<tu-project-ref>
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_NAME=postgres
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_SSLMODE=require

# Usa "update" en el primer arranque si las tablas aún no existen en Supabase.
# Una vez creadas o restauradas, puedes cambiarlo a "validate".
PROD_DDL_AUTO=update

# Secreto JWT en Base64 (OBLIGATORIO, mínimo 32 bytes):
# Genera con: openssl rand -base64 32
PROD_JWT_SECRET=
PROD_JWT_EXPIRATION=86400000

# Dominio público del frontend (reverse proxy apunta a PROD_WEB_BIND:PROD_WEB_PORT)
PROD_CORS_ORIGIN=https://diza.abdieeel.dev
PROD_API_BASE_URL=/api
PROD_WEB_BIND=127.0.0.1
PROD_WEB_PORT=8088

# Administrador inicial (configúralo solo en el primer arranque y luego vacíalo)
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
PROD_ADMIN_NOMBRE=Administrador Bodega DIZA

# SMTP para recuperación de contraseña (opcional; usar contraseña de aplicación dedicada)
PROD_MAIL_USERNAME=
PROD_MAIL_PASSWORD=
