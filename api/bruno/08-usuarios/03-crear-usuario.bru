meta {
  name: Crear Usuario (Cajero / Administrador)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

