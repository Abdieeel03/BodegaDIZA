# Configuración del Servidor
SERVER_PORT=8080

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodega_diza
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración de JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Configuración de JWT
# Secreto Base64 de al menos 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Origen permitido durante desarrollo
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Usuario inicial opcional para desarrollo
ADMIN_EMAIL=admin@bodegadiza.com
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA
ADMIN_NOMBRE=Administrador Diza

# Configuración de Correo Electrónico (Google / Gmail SMTP)
# Generar una contraseña de aplicación en: https://myaccount.google.com/apppasswords
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
